    "Gutschein": {
      "label": "Gutschein-Aktion",
      "formFields": {
        "gutscheinIds": {
          "type": "text",
          "required": false,
          "label": "ID der Gutscheinkampagne (mehrere mit Komma). Code, Laufzeit, Artikel und Etikett-Text (Feld „Beschreibung“ der Kampagne) kommen aus der Kampagne. Leer = aus",
          "options": {
            "defaultValue": ""
          }
        },
        "gutscheinZeile": {
          "type": "text",
          "required": false,
          "label": "Zeile unter dem Artikelbild, {code}, {rabatt} und {ende} werden ersetzt",
          "options": {
            "defaultValue": "Gilt bis {ende}, nicht mit anderen Gutscheinen kombinierbar."
          }
        }
      }
    },
    "Sparen": {
      "label": "Badge „Sie sparen“",
      "formFields": {
        "sparenAktiv": {
          "type": "checkBox",
          "required": false,
          "label": "Badge „Sie sparen“ auf Kacheln mit Streichpreis zeigen",
          "options": {
            "defaultValue": "true"
          }
        },
        "sparenGrenze": {
          "type": "text",
          "required": false,
          "label": "Grenze in Euro (UVP): darunter Prozent, ab dieser UVP Euro-Betrag",
          "options": {
            "defaultValue": "100"
          }
        },
        "sparenTextProzent": {
          "type": "text",
          "required": false,
          "label": "Text unter der Grenze, {prozent} wird ersetzt (z. B. 30 %)",
          "options": {
            "defaultValue": "Sie sparen {prozent}"
          }
        },
        "sparenTextEuro": {
          "type": "text",
          "required": false,
          "label": "Text ab der Grenze, {euro} wird ersetzt (z. B. 27,08 €)",
          "options": {
            "defaultValue": "Sie sparen {euro}"
          }
        }
      }
    },
    "Kachel": {
      "label": "Kachel-Gestaltung",
      "formFields": {
        "kachelAktiv": {
          "type": "checkBox",
          "required": false,
          "label": "Kacheln als Karte: Preis vorn, UVP dahinter, alles linksbündig, leere Sterne ausblenden",
          "options": {
            "defaultValue": "true"
          }
        },
        "lieferAktiv": {
          "type": "checkBox",
          "required": false,
          "label": "Lieferbarkeit unter dem Preis zeigen (bei Vorbestellung mit Erscheinungsdatum)",
          "options": {
            "defaultValue": "true"
          }
        },
        "lieferTextVor": {
          "type": "text",
          "required": false,
          "label": "Text bei Vorbestellung, {datum} wird ersetzt",
          "options": {
            "defaultValue": "Lieferbar ab {datum}"
          }
        },
        "zumAktiv": {
          "type": "checkBox",
          "required": false,
          "label": "Knopf zum Artikel unten in jeder Kachel (nur Rechner)",
          "options": {
            "defaultValue": "true"
          }
        },
        "zumText": {
          "type": "text",
          "required": false,
          "label": "Text des Knopfs",
          "options": {
            "defaultValue": "Zum Artikel"
          }
        }
      }
    },
    "Filter": {
      "label": "Filter auf Kategorieseiten",
      "formFields": {
        "filterAktiv": {
          "type": "checkBox",
          "required": false,
          "label": "Filter als schlanke Liste: häufigste Einträge zuerst, Rest aufklappbar",
          "options": {
            "defaultValue": "true"
          }
        },
        "filterSichtbar": {
          "type": "text",
          "required": false,
          "label": "So viele Einträge je Filter sofort zeigen",
          "options": {
            "defaultValue": "6"
          }
        },
        "filterSucheAb": {
          "type": "text",
          "required": false,
          "label": "Suchfeld ab so vielen Einträgen",
          "options": {
            "defaultValue": "8"
          }
        }
      }
    }
