<style>
/* Gold-Etikett am unteren Bildrand: aufgelegt, links angesetzt, so breit wie der Text; verschiebt nichts */
.cmp-product-thumb .prop-1-1 > .osvb-band { position: absolute; left: 0; bottom: 12px; max-width: 90%; z-index: 2; pointer-events: none; }
.osvb-band .osvb { display: inline-block; max-width: 100%; padding: 5px 14px 5px 10px; border-radius: 0 4px 4px 0; background: #d4b062; color: #0c2a5e; font-weight: bold; font-size: 13px; line-height: 1.25; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
@media (max-width: 575.98px) { .osvb-band .osvb { font-size: 13px; padding: 5px 12px 5px 9px; } }
</style>
<script>
/* OSV Badges: Badges auf Artikelkacheln (Ceres-Kategorien und OSV-Suchergebnisse). Kein MutationObserver, kein Vue.component, kein ceresStore. */
(function () {
  var EIN = {{ einstellungJson | raw }};
  var MARKE = "data-osvb";

  // "1.234,56 €" -> 1234.56; ohne Betrag -> 0
  function betrag(t) {
    var m = String(t || "").match(/(\d{1,3}(?:\.\d{3})+|\d+),(\d{2})/);
    return m ? parseFloat(m[1].replace(/\./g, "") + "." + m[2]) : 0;
  }
  function euro(x) {
    var s = x.toFixed(2).split(".");
    return s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ".") + "," + s[1] + " €";
  }

  // Regeln: jede liefert für eine Kachel einen Badge-Text oder nichts; die erste mit Text gewinnt. Weitere Badges hier anhängen.
  var REGELN = [
    function sparen(k) {
      var del = k.querySelector("del.crossprice, del.osvs-uvp"), preisEl = k.querySelector(".prices .price");
      if (!del || !preisEl) return "";
      var uvp = betrag(del.textContent), t = preisEl.textContent;
      var innen = preisEl.querySelector("del");
      if (innen) t = t.replace(innen.textContent, "");
      var preis = betrag(t);
      if (!(uvp > preis && preis > 0)) return "";
      return uvp < EIN.grenze
        ? EIN.textProzent.split("{prozent}").join(Math.round((uvp - preis) / uvp * 100) + " %")
        : EIN.textEuro.split("{euro}").join(euro(uvp - preis));
    }
  ];

  function kachel(k) {
    var platz = k.querySelector(".thumb-image .prop-1-1");
    if (!platz) return;
    // Das Band trägt einen Text: die erste Regel, die etwas liefert
    var text = "";
    for (var i = 0; i < REGELN.length && !text; i++) { try { text = REGELN[i](k) || ""; } catch (x) { text = ""; } }
    if ((k.getAttribute(MARKE) || "") === text && (!text || platz.querySelector(".osvb-band"))) return; // unverändert
    var alt = platz.querySelector(".osvb-band");
    if (alt) alt.parentNode.removeChild(alt);
    k.setAttribute(MARKE, text);
    if (!text) return;
    var band = document.createElement("div");
    band.className = "osvb-band";
    var b = document.createElement("span");
    b.className = "osvb"; b.textContent = text;
    band.appendChild(b);
    platz.appendChild(band);
  }
  function alle() {
    [].forEach.call(document.querySelectorAll("article.cmp-product-thumb"), function (k) {
      try { kachel(k); } catch (x) { /* Kachel bleibt wie sie ist */ }
    });
  }
  // Kacheln kommen vom Server, per Filter/Blättern neu von Ceres oder später von der OSV-Suche;
  // deshalb nach dem Start der Ceres-App und danach in festen Abständen nachsehen (billig, ändert nur bei Bedarf)
  function start(versuch) {
    var app = window.vueApp;
    if (!(app && app._isMounted) && versuch < 40) { setTimeout(function () { start(versuch + 1); }, 100); return; }
    alle();
    setInterval(alle, 1000);
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", function () { start(0); });
  else start(0);
})();
</script>
